[Unit]
Description=Libcamera → V4L2 Bridge (pipeline only)
After=pipewire.service
Requires=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/gst-launch-1.0 -q libcamerasrc ! queue ! videoconvert ! video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1 ! v4l2sink device=/dev/video32
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
